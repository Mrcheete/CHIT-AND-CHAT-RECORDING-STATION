# Copy this file to .env and fill in the values you have. Every feature
# below degrades gracefully if its key is missing — the server just tells
# the front end that feature isn't configured yet.

PORT=8787

# Shared passcode required (as `Authorization: Bearer <passcode>`) for every
# API route once set. Set this before exposing the server beyond your own
# machine — without it, anyone who can reach the server can read/delete your
# library, email your students, and spend your OpenAI credits.
STUDIO_PASSCODE=

# Used for /api/translate (transcription + translation + text-to-speech).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Used for /api/send to actually email students. Any SMTP provider works
# (Gmail app password, SendGrid, Mailgun, your host's SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chit & Chat <hello@example.com>"

# Public base URL this server is reachable at, used to build share links
# in emails (e.g. https://studio.example.com). Defaults to localhost.
PUBLIC_BASE_URL=http://localhost:8787
