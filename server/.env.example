# Copy this file to .env and fill in the values you have. DATA_DIR,
# TEACHER_EMAIL/TEACHER_PASSWORD, and SESSION_SECRET are required — nothing
# works without a teacher account to log in as. Everything below that
# (translation, email) degrades gracefully if its key is missing — the
# server just tells the front end that feature isn't configured yet.

PORT=8787

# Where the SQLite database and uploaded/rendered video files live. On
# Railway this should point inside your mounted Volume so data survives
# redeploys; locally it defaults to server/data if left blank.
DATA_DIR=

# Your one teacher login. Set both and restart the server to create the
# account (it's only ever seeded once — changing these afterwards does NOT
# change an existing account's password).
TEACHER_EMAIL=
TEACHER_PASSWORD=

# Signs the login session cookie. Set this to a long random string before
# deploying — without it, a new random secret is generated on every restart
# and everyone gets logged out each time.
SESSION_SECRET=

# Used for /api/translate (transcription + translation + text-to-speech).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Used for /api/send to actually email students. Any SMTP provider works
# (Gmail app password, SendGrid, Mailgun, your host's SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chit & Chat <hello@example.com>"

# Public base URL this server is reachable at, used to build share links
# in emails (e.g. your Railway service's URL). Defaults to localhost.
PUBLIC_BASE_URL=http://localhost:8787

# Set by Railway/Nixpacks automatically in production — enables the secure
# (HTTPS-only) session cookie flag. Leave unset for local development over
# plain http://.
NODE_ENV=
